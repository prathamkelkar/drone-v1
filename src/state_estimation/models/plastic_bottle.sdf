<?xml version="1.0"?>
<!--
  Simple clear-plastic bottle built from primitives, ~0.54 m tall.
  Body diameter 0.22 m = KNOWN_OBJECT_WIDTH in object_localizer.py, so the
  detection box width (seen from the side) gives the right range.
  Link origin is at the bottle's middle. Used by glide_bottle.py.
-->
<sdf version="1.9">
  <model name="plastic_bottle">
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.012</ixx><iyy>0.012</iyy><izz>0.003</izz></inertia>
      </inertial>
      <!-- translucent body -->
      <visual name="body">
        <pose>0 0 -0.06 0 0 0</pose>
        <geometry><cylinder><radius>0.11</radius><length>0.36</length></cylinder></geometry>
        <material><ambient>0.6 0.75 0.85 1</ambient><diffuse>0.75 0.9 1.0 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
        <transparency>0.45</transparency>
      </visual>
      <!-- printed label band -->
      <visual name="label">
        <pose>0 0 -0.04 0 0 0</pose>
        <geometry><cylinder><radius>0.1115</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.15 0.4 0.85 1</diffuse></material>
      </visual>
      <!-- tapering shoulder -->
      <visual name="shoulder1">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.6 0.75 0.85 1</ambient><diffuse>0.75 0.9 1.0 1</diffuse></material>
        <transparency>0.45</transparency>
      </visual>
      <visual name="shoulder2">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><cylinder><radius>0.065</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.6 0.75 0.85 1</ambient><diffuse>0.75 0.9 1.0 1</diffuse></material>
        <transparency>0.45</transparency>
      </visual>
      <visual name="neck">
        <pose>0 0 0.23 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.6 0.75 0.85 1</ambient><diffuse>0.75 0.9 1.0 1</diffuse></material>
        <transparency>0.45</transparency>
      </visual>
      <visual name="cap">
        <pose>0 0 0.2775 0 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.05 0.2 0.6 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
