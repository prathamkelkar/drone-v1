<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Project-owned RGB-D Iris. Its ArduPilot model and mesh dependencies
       are copied below; only the compiled ArduPilotPlugin is external. -->
  <model name="iris_depth">
    <include>
      <uri>model://iris_depth_with_ardupilot</uri>
      <name>iris</name>
    </include>

    <link name="camera_link">
      <pose relative_to="iris::iris_with_standoffs::base_link">0.10 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="rgbd_camera" type="rgbd_camera">
        <!-- One optical centre for aligned RGB and depth images. Gazebo
             publishes /camera/image and /camera/depth_image. -->
        <topic>camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.412</horizontal_fov>
          <image>
            <width>640</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <!-- RGB remains visible to 50 m, as in the original camera. -->
          <clip><near>0.1</near><far>50</far></clip>
          <!-- Depth is only valid in [0.1, 4.0] m. -->
          <depth_camera>
            <clip><near>0.1</near><far>4.0</far></clip>
          </depth_camera>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
