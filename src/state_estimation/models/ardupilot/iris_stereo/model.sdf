<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Branch-only project copy: both the ArduPilot Iris and its mesh/model
       dependencies live beside this file. The external ardupilot_gazebo
       checkout provides only the compiled ArduPilotPlugin. -->
  <model name="iris_stereo">
    <include>
      <uri>model://iris_stereo_with_ardupilot</uri>
      <name>iris</name>
    </include>

    <!-- Parallel optical axes: both sensors have the same orientation,
         focal geometry, image size, x and z. In FLU, +y is camera-left.
         Left/right centres are at +/-0.06 m: 0.12 m baseline. -->
    <link name="camera_link">
      <pose relative_to="iris::iris_with_standoffs::base_link">0.10 0.06 0.02 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="left_camera" type="camera">
        <!-- Existing detector/localizer/recorder continue to use these topics. -->
        <topic>camera/image</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>camera/camera_info</camera_info_topic>
          <horizontal_fov>1.412</horizontal_fov>
          <image>
            <width>640</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="left_camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>camera_link</child>
    </joint>

    <link name="camera_right_link">
      <pose relative_to="iris::iris_with_standoffs::base_link">0.10 -0.06 0.02 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="right_camera" type="camera">
        <topic>stereo/right/image</topic>
        <gz_frame_id>camera_right_link</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <camera_info_topic>stereo/right/camera_info</camera_info_topic>
          <horizontal_fov>1.412</horizontal_fov>
          <image>
            <width>640</width>
            <height>640</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="right_camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>camera_right_link</child>
    </joint>
  </model>
</sdf>
