<?xml version="1.0"?>
<sdf version="1.9">
  <model name="iris_cam">
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <name>iris</name>
    </include>

    <link name="camera_link">
      <pose relative_to="iris::iris_with_standoffs::base_link">0.10 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz></inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <topic>camera/image</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <update_rate>30</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.412</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>iris::iris_with_standoffs::base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>
