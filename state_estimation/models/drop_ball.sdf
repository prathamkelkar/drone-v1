<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drop_ball">
    <link name="link">
      <inertial>
        <mass>0.43</mass>
        <inertia>
          <ixx>0.00208</ixx><iyy>0.00208</iyy><izz>0.00208</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
      </collision>
      <!-- orange, for the HSV detector (perception_without_nn) -->
      <visual name="visual">
        <geometry><sphere><radius>0.11</radius></sphere></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
